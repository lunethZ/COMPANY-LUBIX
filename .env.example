# ===== Entorno =====
# development | production
ENVIRONMENT=development
# Puerto local del backend. En Render la plataforma inyecta PORT automáticamente.
PORT=8000

# ===== PostgreSQL local (docker compose) =====
POSTGRES_USER=CHANGE_ME_PG
POSTGRES_PASSWORD=CHANGE_ME_PG
POSTGRES_DB=lubix

# ===== Backend =====
# Cadena principal del backend. En local usa el host "postgres".
# En Neon/Supabase usa la cadena del panel, por ejemplo:
# URL_DATABASE=postgresql+psycopg2://usuario:password@ep-xxxx.neon.tech/lubix?sslmode=require
# Si la contraseña tiene caracteres especiales (@, :, /, #, %), codifícalos con
# URL encoding (por ejemplo @ -> %40).
URL_DATABASE=postgresql+psycopg2://CHANGE_ME_PG:CHANGE_ME_PG@postgres:5432/lubix
# Alias aceptado para plataformas que solo definen DATABASE_URL.
# Si URL_DATABASE está definida, tiene prioridad.
# DATABASE_URL=postgresql+psycopg2://usuario:password@host:5432/db?sslmode=require

# SSL y pool de conexiones (recomendado para Neon/Supabase en producción).
# require | verify-ca | verify-full
DB_SSL_MODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=300
# Reintentos de alembic upgrade head antes de levantar uvicorn (usado por start.sh).
DB_MIGRATION_RETRIES=10
DB_MIGRATION_RETRY_DELAY=3
# En Render uvicorn ya respeta la variable PORT inyectada por la plataforma.
WEB_CONCURRENCY=1

SECRET_KEY=CHANGE_ME_LLAVE_JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_DAYS=7
URL_FRONTEND=http://localhost:5173
# Orígenes adicionales separados por coma (el frontend desplegado, por ejemplo).
CORS_ORIGINS=

# ===== MinIO / almacenamiento S3 compatible =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO
# En Docker local el endpoint es minio:9000. En producción usa el host:puerto
# de tu MinIO/S3 externo (por ejemplo, storage.example.com:9000). Puedes incluir
# https:// delante; MINIO_SECURE decide si la conexión es TLS.
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_BUCKET=uploads
# Región del bucket: vacía en MinIO local, "auto" en Cloudflare R2 y el
# código de región de B2 (por ejemplo us-east-005) en Backblaze.
MINIO_REGION=
# true crea el bucket al arrancar (útil en local). En producción el bucket ya
# existe (B2/R2/MinIO externo) y debe quedar en false.
MINIO_AUTO_CREATE_BUCKET=true

# ===== Email (SMTP Gmail - usar App Password) =====
GMAIL_USERNAME=tucorreo@gmail.com
GMAIL_APP_PASSWORD=CHANGE_ME_APP_PASSWORD

# ===== Email en producción (Brevo - API HTTPS v3) =====
# Proveedor principal: https://api.brevo.com/v3/smtp/email. Render free bloquea
# los puertos SMTP salientes, así que el envío sale por HTTPS. Si BREVO_API_KEY
# está vacía, el backend cae a Resend y, si tampoco hay RESEND_API_KEY, al
# flujo SMTP de Gmail (desarrollo local).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=lubixcompanyemail@gmail.com
BREVO_SENDER_NAME=lubix

# ===== Email en producción (Resend - respaldo) =====
# Solo se usa cuando BREVO_API_KEY no está definida. RESEND_FROM_EMAIL debe
# pertenecer a un dominio verificado en Resend; sin dominio propio funciona
# "LUBIX <onboarding@resend.dev>" para pruebas.
RESEND_API_KEY=
RESEND_FROM_EMAIL=LUBIX <onboarding@resend.dev>

# ===== Admin por defecto / Seed =====
ADMIN_DEFAULT=admin@lubix.com
PASSWORD_DEFAULT=Admin123!
# true solo en el primer arranque para crear roles y admin; luego false.
RUN_SEED=true

# ===== Frontend (Vite) =====
# URL de la API inyectada en tiempo de compilación. En Render apunta a:
# https://lubix-api.onrender.com
# En local con docker-compose: http://localhost:8002
VITE_API_URL=https://lubix-api.onrender.com
