# ===== Entorno =====
# development | production
ENVIRONMENT=development
# Puerto local del backend. En Render la plataforma inyecta PORT automáticamente.
PORT=8000

# ===== PostgreSQL local (docker compose) =====
POSTGRES_USER=CHANGE_ME_PG
POSTGRES_PASSWORD=CHANGE_ME_PG
POSTGRES_DB=lubix

# ===== Backend =====
# Cadena principal del backend. En local usa el host "postgres".
# En Neon/Supabase usa la cadena del panel, por ejemplo:
# URL_DATABASE=postgresql+psycopg2://usuario:password@ep-xxxx.neon.tech/lubix?sslmode=require
# Si la contraseña tiene caracteres especiales (@, :, /, #, %), codifícalos con
# URL encoding (por ejemplo @ -> %40).
URL_DATABASE=postgresql+psycopg2://CHANGE_ME_PG:CHANGE_ME_PG@postgres:5432/lubix
# Alias aceptado para plataformas que solo definen DATABASE_URL.
# Si URL_DATABASE está definida, tiene prioridad.
# DATABASE_URL=postgresql+psycopg2://usuario:password@host:5432/db?sslmode=require

# SSL y pool de conexiones (recomendado para Neon/Supabase en producción).
# require | verify-ca | verify-full
DB_SSL_MODE=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_RECYCLE=300

SECRET_KEY=CHANGE_ME_LLAVE_JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_DAYS=7
URL_FRONTEND=http://localhost:5173
# Orígenes adicionales separados por coma (el frontend desplegado, por ejemplo).
CORS_ORIGINS=

# ===== MinIO / almacenamiento S3 compatible =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO
# En Docker local el endpoint es minio:9000. En producción usa el host:puerto
# de tu MinIO/S3 externo (por ejemplo, storage.example.com:9000).
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_BUCKET=uploads
# true crea el bucket al arrancar (útil en local). En producción con un bucket
# ya creado se puede dejar en false para no bloquear el arranque si el storage
# todavía no responde.
MINIO_AUTO_CREATE_BUCKET=true

# ===== Email (SMTP Gmail - usar App Password) =====
GMAIL_USERNAME=tucorreo@gmail.com
GMAIL_APP_PASSWORD=CHANGE_ME_APP_PASSWORD

# ===== Admin por defecto / Seed =====
ADMIN_DEFAULT=admin@lubix.com
PASSWORD_DEFAULT=Admin123!
# true solo en el primer arranque para crear roles y admin; luego false.
RUN_SEED=true
